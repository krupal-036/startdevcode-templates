# --- SERVER CONFIGURATION ---
PORT=3000
NODE_ENV=development

# --- DATABASE CONFIGURATION ---
# Which DB backend to use at runtime: "mongodb" | "mysql"
DB_TYPE=mongodb

# MongoDB (used when DB_TYPE=mongodb)
MONGO_URI=mongodb://localhost:27017
DB_NAME=your_database_name

# MySQL (used when DB_TYPE=mysql)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=your_mysql_database

# --- SECURITY & AUTHENTICATION ---
JWT_SECRET=your_jwt_secret_key_change_me_in_production
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- SEED / INITIAL ADMIN CREDENTIALS ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose_a_strong_password_here