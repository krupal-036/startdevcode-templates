{
    "name": "backend",
    "version": "0.0.0",
    "main": "main.js",
    "description": "",
    "scripts": {
        "dev": "tsx watch src/main.ts",
        "start": "node dist/main.js",
        "build": "tsc && tsc-alias",
        "db:reset": "node scripts/reset-db.js",
        "format": "prettier --write \"**/*.{ts,json,md}\"",
