# --- SERVER CONFIGURATION ---
# The port number the Express backend server will run on
PORT=3000

# The environment layout: development, production, or test
NODE_ENV=development

# --- DATABASE CONFIGURATION ---
# Your MongoDB connection string (e.g., mongodb://localhost:27017 or MongoDB Atlas URI)
MONGO_URI=mongodb://localhost:27017

# The name of the specific database to use inside MongoDB
DB_NAME=your_database_name

# --- SECURITY & AUTHENTICATION ---
# A secure, random string used to sign and verify JSON Web Tokens
JWT_SECRET=your_jwt_secret_key_change_me_in_production

# Allowed client origins for CORS configuration (use commas to separate multiple URLs)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- SEED / INITIAL ADMIN CREDENTIALS ---
# Default administrative user configuration used for initial setup
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose_a_strong_password_here
